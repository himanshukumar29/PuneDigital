# ==============================================================================
# PuneDigital - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your keys.

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (Google Maps Platform)
# Enable "Places API (New)" in Google Cloud Console
# Covers 5,000+ searches/month under the recurring $200 free monthly credit.
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API (AI Studio)
# Get a free key at https://aistudio.google.com/
# Free quota: 15 Requests/Min, 1 Million tokens/day (Gemini 2.0 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase (Database & Storage)
# Free project at https://supabase.com
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 4. Telegram Notifications (To notify you when a demo is ready for review)
# Create a bot with @BotFather on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# 5. WhatsApp (Evolution API - Self-Hosted on Oracle Cloud or Local Docker)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_global_key

# ------------------------------------------------------------------------------
# 6. Public Demo Site Domain (Vercel)
# In bootstrap mode, use your Vercel URL e.g. https://punedigital.vercel.app
# In scale mode, switch to https://punedigital.in
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://punedigital.vercel.app
