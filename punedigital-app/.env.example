# Google Places API Key (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Public Base URL (on Vercel, set this to your Vercel deployment URL e.g. https://punedigital.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Agency Admin Route Protection on Vercel:
# Leave blank to COMPLETELY BLOCK /agency on Vercel (returns 404 to all clients)
# Or set a secret passcode to access it privately via https://your-domain.vercel.app/agency?secret=YOUR_PASSCODE
AGENCY_SECRET_PASSCODE=pune2026

# Agency Owner Contact Details (shown to clients when claiming website via WhatsApp or Email):
NEXT_PUBLIC_AGENCY_NAME=PuneDigital
NEXT_PUBLIC_AGENCY_WHATSAPP=919823045678
NEXT_PUBLIC_AGENCY_EMAIL=contact@punedigital.in
